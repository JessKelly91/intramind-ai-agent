# API Gateway Configuration
API_GATEWAY_URL=http://localhost:5000
API_GATEWAY_TIMEOUT=30

# LLM Configuration - Primary (for reasoning & synthesis)
PRIMARY_LLM_PROVIDER=anthropic  # Options: anthropic, openai, ollama
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# LLM Configuration - Router (for classification & routing)
ROUTER_LLM_PROVIDER=ollama  # Options: ollama, anthropic, openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Primary LLM Model Selection
ANTHROPIC_MODEL=claude-3-5-haiku-20241022  # Fast & cost-effective
OPENAI_MODEL=gpt-3.5-turbo

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true
ENABLE_STREAMING=true

# Multimodal Processing
ENABLE_OCR=true
TESSERACT_PATH=/usr/bin/tesseract  # Adjust for your system
MAX_FILE_SIZE_MB=50

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, console

# Collection Settings
DEFAULT_COLLECTION=intramind_documents
SEARCH_LIMIT=10
SYNTHESIS_MAX_CONTEXTS=3
SYNTHESIS_CONTEXT_CHARS=1200
SYNTHESIS_SCORE_GAP=0.12

# Prompt Registry (optional; unset URL keeps baked-in prompt fallback only)
PROMPT_REGISTRY_URL=
PROMPT_REGISTRY_LABEL=production
PROMPT_REGISTRY_API_KEY=service-dev-key
PROMPT_REGISTRY_CACHE_TTL=60

# Responsible AI enforcement
# Defaults are permissive for local development. Set required=true in production
# so ingestion/search fail closed if Presidio/spaCy or Llama Guard are unavailable.
ENABLE_PII_REDACTION=true
PII_REDACTION_REQUIRED=false
ENABLE_SAFETY_GUARD=true
SAFETY_GUARD_REQUIRED=false
SAFETY_GUARD_MODEL=llama-guard3
